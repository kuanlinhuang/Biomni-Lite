# Biomni Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Required: Anthropic API Key for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: AWS Bedrock Configuration (if using AWS Bedrock models)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1

# Optional: Custom model serving configuration
# CUSTOM_MODEL_BASE_URL=http://localhost:8000/v1
# CUSTOM_MODEL_API_KEY=your_custom_api_key_here

# Optional: Biomni data path (defaults to ./data)
# BIOMNI_PATH=/path/to/your/data

# Optional: Default LLM model (defaults to claude-opus-4-5)
# BIOMNI_LLM=claude-opus-4-5

# Optional: Agent to launch in Gradio UI (a1 or ad1; omit for interactive selector)
# BIOMNI_AGENT=

# Optional: Timeout settings
# BIOMNI_TIMEOUT_SECONDS=600

# Optional: Tool retriever (disabled by default in Docker for VPN/restricted-network robustness)
# Set to true to enable smart tool selection (requires an extra LLM call per query)
# BIOMNI_USE_TOOL_RETRIEVER=false

# Optional: For VPN/corporate networks with SSL inspection, point to your CA bundle:
# SSL_CERT_FILE=/path/to/ca-bundle.crt
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt

# Optional: Host port for the Gradio web UI (defaults to 7860)
# Useful when port 7860 is already in use or blocked on your VM.
# GRADIO_PORT=7860
